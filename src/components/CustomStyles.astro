---

---

<style>
  @import '@fontsource-variable/inter';
</style>

<style is:inline>
  /*
   * Map AstroWind's --aw-color-* vars to the Linkvec design tokens
   * defined in src/assets/styles/tokens.css.
   * Do not put color values here — update tokens.css instead.
   */
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: var(--color-accent);
    --aw-color-secondary: var(--color-accent-hover);
    --aw-color-accent: var(--color-accent);

    --aw-color-text-heading: var(--color-text-primary);
    --aw-color-text-default: var(--color-text-primary);
    --aw-color-text-muted: var(--color-text-muted);
    --aw-color-bg-page: var(--color-bg);
    --aw-color-bg-page-dark: var(--color-bg);

    ::selection {
      background-color: color-mix(in srgb, var(--color-accent) 15%, transparent);
    }
  }

  .dark {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: var(--color-accent);
    --aw-color-secondary: var(--color-accent-hover);
    --aw-color-accent: var(--color-accent);

    --aw-color-text-heading: var(--color-text-primary);
    --aw-color-text-default: var(--color-text-primary);
    --aw-color-text-muted: var(--color-text-muted);
    --aw-color-bg-page: var(--color-bg);
    --aw-color-bg-page-dark: var(--color-bg);

    ::selection {
      background-color: color-mix(in srgb, var(--color-accent) 20%, transparent);
    }
  }
</style>
