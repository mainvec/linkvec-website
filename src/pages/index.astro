---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'iulink — Connect on your terms',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Get Started',
        href: '/download',
        icon: 'tabler:download',
      },
      { text: 'Read the docs', href: 'https://docs.iulink.com', target: '_blank' },
    ]}
    image={{ src: '~/assets/images/iulink-hero.png', alt: 'iulink — expose ports and share services through any NAT' }}
  >
    <Fragment slot="title">
      Connect on <span class="text-accent dark:text-white">your terms.</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        iulink is a connectivity platform that lets you expose ports, share services, and build mesh VPNs through any
        NAT — with your broker or ours.
      </span>
      <span class="block mb-1 sm:hidden font-bold text-blue-600">Expose ports through any NAT. No router config.</span>
    </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->

  <Note title="The principle:" description="Full product. Full choice. Your broker, your path, your relay." />

  <!-- Features Widget *************** -->

  <Features
    id="features"
    tagline="What iulink gives you"
    title="Every layer is a choice, not a constraint."
    subtitle="Most connectivity tools lock you into their infrastructure. iulink exposes the controls."
    items={[
      {
        title: 'Bring your own broker',
        description:
          'Run iubroker on any VPS or homelab machine. Your data plane never touches our servers. Or use our hosted broker — same CLI, same protocol.',
        icon: 'tabler:server',
      },
      {
        title: 'Works through any NAT',
        description:
          'CGNAT, double-NAT, strict firewalls — iulink uses a three-path fallback model. Direct when possible, relayed when not. Automatic and silent.',
        icon: 'tabler:network',
      },
      {
        title: 'No root required',
        description:
          'The daemon runs as your user. Serverlets expose a local port. Nothing binds to privileged ports. Nothing runs as root.',
        icon: 'tabler:shield-lock',
      },
      {
        title: 'HTTP services over the broker',
        description:
          'Weblets expose local HTTP services through your broker without QUIC or a relay. Share a dev server or dashboard with a URL instead of a port.',
        icon: 'tabler:world',
      },
      {
        title: 'Mesh VPN in one command',
        description:
          'Netlets create WireGuard-based mesh VPNs between machines. BrokerMesh covers an entire broker with a single command.',
        icon: 'tabler:topology-star',
      },
      {
        title: 'Hub sharing',
        description:
          'Group your tunnels into hubs and share them with teammates or family. Revoke access without touching the remote machine.',
        icon: 'tabler:share',
      },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    isReversed
    tagline="Security model"
    title="Your services. Invisible to the internet."
    items={[
      {
        title: 'Broker as your network boundary',
        description:
          'The broker is the only public-facing component. Your SSH daemon, dev server, or database is never exposed — the broker is the gatekeeper.',
      },
      {
        title: 'No inbound ports on your machine',
        description:
          'Serverlets initiate outbound connections to the broker. Your firewall stays closed. No port forwarding, no DMZ.',
      },
      {
        title: 'Self-hosted means self-controlled',
        description:
          'Run iubroker on hardware you own. Audit the code. Rotate the keys. Set your own access policies.',
      },
    ]}
    image={{
      src: '~/assets/images/security-model.png',
      alt: 'Broker boundary protecting private services',
    }}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    tagline="Three-path model"
    title="Choose your path — or let iulink choose for you."
    items={[
      {
        title: 'Direct (peer-to-peer)',
        description:
          'When both peers can reach each other, iulink establishes a direct connection. No relay, no latency overhead.',
      },
      {
        title: 'Broker-routed',
        description:
          'When direct fails, traffic flows through your broker. Still end-to-end between your machines, just using the broker as a relay.',
      },
      {
        title: 'UDP relay',
        description:
          'When the broker path is blocked, iulink falls back to a relay node. Fully automatic — you never configure this.',
      },
    ]}
    image={{
      src: '~/assets/images/three-path-model.png',
      alt: 'Direct broker and relay connection paths',
    }}
  />

  <!-- Steps Widget ****************** -->

  <Steps
    title="Up and running in three commands."
    items={[
      {
        title: 'Step 1: <span class="font-medium">Install</span>',
        description:
          'One-liner installer. Runs as your user — no root, no sudo, no package manager lock-in.<br><br><code class="text-sm bg-slate-100 dark:bg-slate-800 px-3 py-1 rounded font-mono">curl -fsSL https://get.iulink.com | sh</code>',
        icon: 'tabler:download',
      },
      {
        title: 'Step 2: <span class="font-medium">Expose a port</span>',
        description:
          'Create a named serverlet for any local port. Works behind CGNAT — no router config needed.<br><br><code class="text-sm bg-slate-100 dark:bg-slate-800 px-3 py-1 rounded font-mono">iulink expose --port 8080 --name myservice</code>',
        icon: 'tabler:plug',
      },
      {
        title: 'Step 3: <span class="font-medium">Connect from anywhere</span>',
        description:
          'Connect by service name from any other machine. The broker handles routing.<br><br><code class="text-sm bg-slate-100 dark:bg-slate-800 px-3 py-1 rounded font-mono">iulink connect --service iulink://myservice</code>',
        icon: 'tabler:plug-connected',
      },
      {
        title: "You're in.",
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: '~/assets/images/three-commands.png',
      alt: 'Three setup commands connecting a local service',
    }}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="Common questions"
    tagline="FAQs"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'Does it work behind CGNAT?',
        description:
          'Yes. CGNAT is the primary use case. iulink never requires inbound ports on your machine. It uses outbound connections to the broker, with relay fallback when needed.',
      },
      {
        title: 'Can I run my own broker?',
        description:
          'Yes. iubroker is open-source (AGPL) and runs on any Linux machine. Point the iulink CLI at your own broker with one config line.',
      },
      {
        title: 'Does iulink require root?',
        description:
          'No. The daemon and all tunnel types run as a normal user. Nothing binds to privileged ports. WireGuard-based tunnels (Netlet) require a kernel module, which is present on most modern Linux distros.',
      },
      {
        title: 'What happens if my broker goes down?',
        description:
          'Existing direct peer-to-peer connections stay up. New connections and relay-dependent tunnels will fail until the broker is restored. Self-hosted broker users control their own uptime.',
      },
      {
        title: 'How is iulink different from ngrok or Cloudflare Tunnel?',
        description:
          'Those tools manage the infrastructure for you — you use their broker, their relay, their rules. iulink gives you the same capabilities but lets you run any component yourself. Same product, full choice.',
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Get Started',
        href: '/download',
        icon: 'tabler:download',
      },
      {
        text: 'Why iulink?',
        href: '/why-iulink',
      },
    ]}
  >
    <Fragment slot="title">
      Start free. Bring your own broker.<br class="hidden md:block" /> No vendor lock-in.
    </Fragment>

    <Fragment slot="subtitle">
      The free tier includes everything. Upgrade only if you want us to manage the infrastructure.
    </Fragment>
  </CallToAction>
</Layout>
