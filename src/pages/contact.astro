---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Contact — Linkvec',
  description: 'Get in touch with the Linkvec team. Questions, partnership ideas, or just want to talk connectivity.',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText
    tagline="Contact"
    title="Get in touch."
    subtitle="Questions, partnership ideas, or just want to talk connectivity."
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Where to find us."
    columns={3}
    items={[
      {
        title: 'Email',
        description: 'hi@linkvec.com — for business inquiries, partnership, and press.',
        icon: 'tabler:mail',
      },
      {
        title: 'Discord',
        description: 'Community server — fastest way to get help and follow development.',
        icon: 'tabler:brand-discord',
      },
      {
        title: 'GitHub Discussions',
        description:
          'Primary support channel for Free tier users. Search before opening — your question is probably answered.',
        icon: 'tabler:brand-github',
      },
    ]}
  />

  <!-- Contact Widget **************** -->

  <ContactUs
    id="form"
    title="Send a message."
    subtitle="We'll get back to you. For faster answers, check GitHub Discussions or Discord first."
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Name',
      },
      {
        type: 'email',
        name: 'email',
        label: 'Email',
      },
    ]}
    textarea={{
      label: 'Message',
    }}
    disclaimer={{
      label: 'By submitting this form, you agree to the collection of your contact details to respond to your inquiry.',
    }}
    description="We typically respond within one business day."
  />
</Layout>
