---
import Content from '~/components/widgets/Content.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Steps from '~/components/widgets/Steps.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'About iulink',
  description: 'iulink is a connectivity platform built out of frustration with CGNAT and the gap between managed tools and DIY WireGuard.',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="About"
    image={{
      src: 'https://images.unsplash.com/photo-1558494949-ef010cbdcc31?auto=format&fit=crop&w=2034&q=80',
      alt: 'Server rack — the kind iulink helps you reach from anywhere',
    }}
  >
    <Fragment slot="title">
      Built because <span class="text-accent dark:text-white">CGNAT is annoying.</span>
    </Fragment>

    <Fragment slot="subtitle">
      iulink started as a personal tool for reaching machines behind carrier-grade NAT. It turned into a platform when
      it became clear the problem needed more than a script.
    </Fragment>
  </Hero>

  <!-- Content Widget **************** -->

  <Content
    isReversed
    title="Why iulink exists."
    items={[
      {
        title: 'The problem',
        description:
          'Most ISPs hand out CGNAT addresses. SSH tunnels break on reconnect. ngrok works but you cannot run the broker. Tailscale works but the coordination server is theirs. WireGuard works but you need static IPs and a weekend to configure it.',
      },
      {
        title: 'The gap',
        description:
          'Every tool forces a choice: take the managed product (no control) or do it yourself (no product). There was nothing that provided both a complete, polished tool and the option to own every layer of infrastructure.',
      },
      {
        title: 'The decision',
        description:
          'Build it. Named tunnels, three-path routing, HTTP-over-broker, mesh VPN, hub sharing — with a self-hostable broker as a first-class component, not a bolted-on option.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1629654297299-c8506221ca97?auto=format&fit=crop&w=987&q=80',
      alt: 'Developer working at a terminal',
    }}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->

  <Steps
    title="What iulink believes."
    items={[
      {
        title: '<span class="font-medium">Choice is a feature, not a trade-off.</span>',
        description:
          'Choosing your broker, your path, your relay should not cost you usability. iulink makes every layer configurable without making it complicated.',
        icon: 'tabler:adjustments',
      },
      {
        title: '<span class="font-medium">Your data plane should be yours.</span>',
        description:
          'If you self-host the broker, your traffic never touches a third-party server. That is a structural guarantee, not a policy that can change.',
        icon: 'tabler:shield',
      },
      {
        title: '<span class="font-medium">Security should be structural, not just configured.</span>',
        description:
          'No root daemon. No inbound ports. Bounded blast radius per tunnel. These are design decisions, not optional hardening steps.',
        icon: 'tabler:lock',
      },
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    title="Find iulink."
    subtitle="The project is open. Come read the code, ask questions, or just follow along."
    columns={3}
    items={[
      {
        title: 'GitHub',
        description: 'Source code, issues, and releases. The CLI and iubroker are both on GitHub.',
        icon: 'tabler:brand-github',
        callToAction: {
          text: 'View on GitHub',
          href: 'https://github.com/iulink',
          target: '_blank',
        },
      },
      {
        title: 'Discord',
        description: 'Community server for questions, sharing setups, and following development.',
        icon: 'tabler:brand-discord',
        callToAction: {
          text: 'Join Discord',
          href: 'https://discord.gg/iulink',
          target: '_blank',
        },
      },
      {
        title: 'Docs',
        description: 'Reference documentation, quickstart guides, and broker setup instructions.',
        icon: 'tabler:book',
        callToAction: {
          text: 'Read the docs',
          href: 'https://docs.iulink.com',
          target: '_blank',
        },
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    title="Explore the product."
    subtitle="Install in 60 seconds. Bring your own broker or use ours."
    actions={[
      {
        variant: 'primary',
        text: 'Get Started',
        href: '/download',
        icon: 'tabler:download',
      },
      {
        text: 'View on GitHub',
        href: 'https://github.com/iulink',
        target: '_blank',
      },
    ]}
  />
</Layout>
