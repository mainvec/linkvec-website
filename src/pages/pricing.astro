---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Prices from '~/components/widgets/Pricing.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Steps from '~/components/widgets/Steps.astro';
import Features3 from '~/components/widgets/Features3.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Pricing — iulink',
  description:
    'iulink is free to use. Paid plans are just us managing infrastructure for you — the product and protocol are identical across all tiers.',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText
    tagline="Pricing"
    title="Infrastructure you control — or we run it for you."
    subtitle="Paid tiers are us managing infrastructure. The product and protocol are the same across every plan."
  />

  <!-- Pricing Widget ******************* -->

  <Prices
    title="Simple, honest pricing."
    subtitle="Everything works on the free tier. Upgrading just means we handle the broker for you."
    prices={[
      {
        title: 'Community',
        subtitle: 'Everything. You supply the infra.',
        price: 0,
        period: 'forever free',
        items: [
          { description: 'Full CLI — all tunnel types (Serverlet, Clientlet, Weblet, Netlet)' },
          { description: 'iubroker self-hosted (AGPL) — run on any VPS or homelab' },
          { description: 'Connect to the shared hosted broker' },
          { description: 'Community relay nodes' },
          { description: 'Hub sharing — share services with others' },
          { description: 'No machine limits, no bandwidth caps on BYOB' },
        ],
        callToAction: {
          text: 'Get Started',
          href: '/download',
        },
      },
      {
        title: 'Developer',
        subtitle: 'Dedicated hosted broker. Flat rate.',
        price: 9,
        period: 'per month',
        items: [
          { description: 'Everything in Community' },
          { description: 'Dedicated broker — your traffic stays isolated' },
          { description: 'Persistent relay allocation — lower latency than shared pool' },
          { description: 'Web dashboard for hub and tunnel management' },
          { description: 'Email support' },
          { description: 'Annual billing available ($90/yr — 2 months free)' },
        ],
        callToAction: {
          text: 'Start Developer plan',
          href: 'https://app.iulink.com/signup?plan=developer',
        },
        hasRibbon: true,
        ribbonTitle: 'Most popular',
      },
      {
        title: 'Team',
        subtitle: 'Broker cluster, audit log, admin console.',
        price: 14,
        period: 'per user / month',
        items: [
          { description: 'Everything in Developer' },
          { description: 'High-availability broker cluster' },
          { description: 'Audit log and access controls' },
          { description: 'Admin console — manage members and hubs' },
          { description: 'Slack / Teams support channel' },
          { description: 'Minimum 2 users' },
        ],
        callToAction: {
          text: 'Start Team plan',
          href: 'https://app.iulink.com/signup?plan=team',
        },
      },
      {
        title: 'Self-Hosted Pro',
        subtitle: 'Commercial iubroker license.',
        price: 199,
        period: 'per year flat',
        items: [
          { description: 'Commercial license for iubroker (no AGPL copyleft requirement)' },
          { description: 'Priority security patches and CVE notifications' },
          { description: 'Compliance documentation (SOC 2 readiness guide)' },
          { description: 'Private Slack channel' },
          { description: 'SLA-backed email support' },
          { description: 'No per-machine or per-user charges' },
        ],
        callToAction: {
          text: 'Buy Self-Hosted Pro',
          href: 'https://app.iulink.com/signup?plan=selfhosted-pro',
        },
      },
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    title="What stays free forever."
    subtitle="No bait-and-switch. These capabilities will never move behind a paywall."
    columns={3}
    items={[
      {
        title: 'Full CLI',
        description:
          'Every tunnel type — Serverlet, Clientlet, Weblet, WebClientlet, Netlet, BrokerMesh — free forever.',
        icon: 'tabler:terminal-2',
      },
      {
        title: 'Self-hosted iubroker',
        description: 'The broker is open-source (AGPL). Run it on any machine you control, always.',
        icon: 'tabler:server',
      },
      {
        title: 'Shared hosted broker',
        description: 'Free access to our shared broker. Great for personal use and getting started.',
        icon: 'tabler:cloud',
      },
    ]}
    classes={{ container: 'max-w-5xl' }}
  />

  <!-- Steps Widget ****************** -->

  <Steps
    title="Upgrading takes under 60 seconds."
    tagline="How it works"
    isReversed={true}
    items={[
      {
        title: 'Start free — BYOB or shared broker',
        icon: 'tabler:number-1',
      },
      {
        title: 'Hit a limit or want isolated infrastructure',
        icon: 'tabler:number-2',
      },
      {
        title: 'Choose a plan and sign up',
        icon: 'tabler:number-3',
      },
      {
        title: 'Broker provisioned automatically',
        icon: 'tabler:number-4',
      },
      {
        title: 'Update one line in your config',
        icon: 'tabler:number-5',
      },
      {
        title: 'All your existing hubs and tunnels keep working',
        icon: 'tabler:number-6',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1558494949-ef010cbdcc31?auto=format&fit=crop&w=987&q=80',
      alt: 'Server infrastructure',
    }}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="Pricing FAQs"
    subtitle="Still have questions? These are the ones we hear most often."
    columns={1}
    items={[
      {
        title: 'Is anything unlimited on the free tier?',
        description:
          'When you bring your own broker (BYOB), there are no machine limits, no tunnel limits, and no bandwidth caps imposed by iulink. The only limits are those of the machine running your broker.',
      },
      {
        title: 'What exactly do paid plans include that free does not?',
        description:
          'Paid plans mean we provision and operate the broker infrastructure for you — dedicated broker nodes, relay allocation, HA clustering (Team), and SLA-backed support. The CLI, protocol, and all tunnel types are identical across every tier.',
      },
      {
        title: 'Can I self-host the broker and still upgrade?',
        description:
          'Yes. Self-Hosted Pro is specifically for teams that want to keep running their own broker but need a commercial license for iubroker (removes the AGPL copyleft requirement) and enterprise support.',
      },
      {
        title: 'Can I switch brokers after upgrading?',
        description:
          'Yes. Switching brokers is a single config change. Your hubs, tunnels, and service names are portable — they are not tied to any broker.',
      },
      {
        title: 'What is a dedicated broker?',
        description:
          'On the Developer plan and above, we provision a broker node exclusively for your account. Traffic from other accounts never touches your broker. This also means your tunnels are not affected by activity from other users.',
      },
      {
        title: 'Is the CLI always free?',
        description:
          'Yes, the iulink CLI is open-source (AGPL) and will always be free to download and use. You can use it with any broker — ours or your own.',
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    title="Start free. Upgrade when you need infrastructure."
    subtitle="No credit card required to get started. Bring your own broker or use ours."
    actions={[
      {
        variant: 'primary',
        text: 'Get Started',
        href: '/download',
      },
      {
        text: 'Read the docs',
        href: 'https://docs.iulink.com',
        target: '_blank',
      },
    ]}
  />
</Layout>
